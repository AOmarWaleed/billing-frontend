{
  "typography": {
    "fontFamily": "Nunito, Arial, sans-serif, Segoe UI",
    "fontSize": 11,
    "body1": {
      "fontSize": "0.9rem"
    }
  },

  "components": {
    "MuiTableContainer": {
      "styleOverrides": {
        "root": {
          "background": "#ffffff"
        }
      }
    },

    "MuiTableCell": {
      "styleOverrides": {
        "root": {
          "color": "#000000"
        }
      }
    },

    "MuiButton": {
      "defaultProps": {
        "variant": "text",
        "color": "primary",
        "size": "small",
        "disableElevation": false,
        "disableRipple": false,
        "disableFocusRipple": false,
        "fullWidth": false
      },
      "styleOverrides": {
        "root": {
          "fontSize": "0.8rem",
          "fontFamily": "Nunito, Arial, sans-serif, Segoe UI",
          "borderRadius": "6px",
          "textTransform": "none",
          "fontWeight": "400",
          "&.ex-small": {
            "padding": "1px 2px",
            "margin": "1px"
          }
        }
      }
    },

    "MuiDataGrid": {
      "styleOverrides": {
        "root": {
          "fontSize": ".78rem",
          "&.exact-25px-rows": {
            "& .MuiDataGrid-row": {
              "maxHeight": "25px !important",
              "minHeight": "25px !important",
              "height": "25px !important"
            },
            "& .MuiDataGrid-cell": {
              "maxHeight": "25px !important",
              "minHeight": "25px !important",
              "height": "25px !important",
              "lineHeight": "25px !important",
              "whiteSpace": "nowrap",
              "overflow": "hidden",
              "textOverflow": "ellipsis",
              "display": "block"
            }
          },
          "&.exact-40px-rows": {
            "& .MuiDataGrid-row": {
              "maxHeight": "40px !important",
              "minHeight": "40px !important",
              "height": "40px !important"
            },
            "& .MuiDataGrid-cell": {
              "maxHeight": "40px !important",
              "minHeight": "40px !important",
              "height": "40px !important",
              "lineHeight": "40px !important",
              "whiteSpace": "nowrap",
              "overflow": "hidden",
              "textOverflow": "ellipsis",
              "display": "block"
            }
          },
           "&.exact-50px-rows": {
            "& .MuiDataGrid-row": {
              "maxHeight": "50px !important",
              "minHeight": "50px !important",
              "height": "50px !important"
            },
            "& .MuiDataGrid-cell": {
              "maxHeight": "50px !important",
              "minHeight": "50px !important",
              "height": "50px !important",
              "lineHeight": "50px !important",
              "whiteSpace": "nowrap",
              "overflow": "hidden",
              "textOverflow": "ellipsis",
              "display": "block"
            }
          },
          "& .MuiDataGrid-overlayWrapperInner": {
            "height": "100%",
            "display": "flex",
            "alignItems": "center",
            "justifyContent": "center"
          },
          "& .MuiDataGrid-columnHeaderTitleContainerContent, & .MuiDataGrid-columnHeaderTitleContainerContent > div": {
            "width": "100%"
          },
          "& .MuiDataGrid-virtualScrollerContent": {
            "marginBottom": "10px !important"
          },
          "& .MuiDataGrid-virtualScroller .MuiDataGrid-filler": {
            "display": "none"
          },
          "& .MuiDataGrid-root--densityStandard": {
            "max-height": "100% !important"
          },
          "& .MuiDataGrid-columnHeaders, .MuiDataGrid-row--borderBottom, .MuiDataGrid-columnHeader": {
            "height": "100% !important"
          },
          "&:has(.MuiDataGrid-overlay) .MuiDataGrid-footerContainer": {
            "display": "none"
          },
          "&:has(.MuiDataGrid-overlay) .MuiDataGrid-virtualScrollerContent": {
            "marginBottom": "0px !important"
          },
          "&:has(.MuiDataGrid-overlayWrapperInner) .MuiDataGrid-main + .MuiBox-root": {
            "display": "none"
          },
          "& .MuiTablePagination-actions button": {
            "padding": "0px"
          },
          "& .MuiDataGrid-root": {
            "overflow": "hidden"
          },
          "& .MuiDataGrid-topContainer": {
            "height": "30px !important"
          },
          "& .MuiDataGrid-iconButtonContainer": {
            "display": "none"
          },
          "& .MuiBox-root:has(.GlCustomPagination)": {
            "padding": "0px",
            "marginTop": "-10px !important"
          },
          "& .GlCustomPagination": {
            "padding": "4px",
            "& .MuiSelect-select, & input": {
              "padding": "2px 4px"
            },
            "& .GlCustomPagination-button": {
              "fontWeight": "normal",
              "width": 25,
              "height": 25,
              "fontSize": "0.6rem"
            }
          },
          "& .MuiDataGrid-menuIconButton": {
            "width": "12px"
          },
          "& .MuiDataGrid-row": {
            "&.Mui-selected:not(.highlighted-row)": {
              "backgroundColor": "#55C5D6 !important"
            },
            "maxHeight": "25px !important",
            "minHeight": "25px !important",
            "height": "25px !important"
          },
          "& .MuiDataGrid-row:nth-of-type(odd)": {
            "backgroundColor": "rgba(202, 215, 231, 0.15)",
            "transition": ".5s all"
          },

          "& .MuiDataGrid-row:nth-of-type(even)": {
            "backgroundColor": "rgba(85 , 197 , 197 , .15)",
            "transition": ".5s all"
          },
          "& .MuiDataGrid-row:nth-of-type(odd):hover": {
            "backgroundColor": "rgba(202, 215, 231, 0.44)"
          },
          "& .MuiDataGrid-row:nth-of-type(even):hover": {
            "backgroundColor": "rgba(85 , 197 , 197 , .44)"
          },
          "& .MuiDataGrid-footerContainer": {
            "backgroundColor": "#2764Af00",
            "height": "30px",
            "minHeight": "30px",
            "marginTop": "-10px !important"
          },
          "& .MuiDataGrid-footerContainer input": {
            "padding": "1px 2px !important",
            "fontSize": "0.75rem"
          },
          "&.MuiDataGrid-root--noRows": {
            "minHeight": "50px !important",
            "height": "auto !important",
            "& .MuiDataGrid-virtualScroller": {
              "minHeight": "30px !important"
            },
            "& .MuiDataGrid-overlay": {
              "position": "relative",
              "transform": "none",
              "height": "30px",
              "display": "flex",
              "alignItems": "center",
              "justifyContent": "center"
            }
          },
          "& .MuiTablePagination-root": {},
          "& .MuiDataGrid-footerContainer .MuiToolbar-root": {
            "overflow": "hidden !important",
            "minHeight": "auto"
          },
          "& .MuiDataGrid-footerContainer .MuiToolbar-root > *": {
            "marginTop": "0px",
            "marginBottom": "0px"
          },

          "& .MuiDataGrid-columnHeaders > div ": {
            "backgroundColor": "#2764AF !important",
            "color": "white"
          },
          "& .MuiDataGrid-columnHeaders": {
            "backgroundColor": "#2764AF !important"
          },
          "borderRadius": "8px",

          "& .MuiDataGrid-cell": {
            "padding": "0 5px",
            "maxHeight": "25px !important",
            "minHeight": "25px !important",
            "height": "25px !important",
            "lineHeight": "25px !important",
            "whiteSpace": "nowrap",
            "overflow": "hidden",
            "textOverflow": "ellipsis",
            "display": "block"
          },
          "& .MuiDataGrid-overlay": {
            "backgroundColor": "transparent",
            "height": "auto",
            "& .MuiTypography-root": {
              "fontSize": "0.85rem",
              "color": "#666"
            }
          }
        },
        "row": {
          "& .MuiDataGrid-cell:focus, & .MuiDataGrid-cell:focus-within": {
            "outline": "none"
          },
          "& .MuiOutlinedInput-root": { "borderRadius": "6" },
          "& input": { "padding": "4px 8px", "borderRadius": "6" }
        },
        "columnHeader": {
          "& .MuiDataGrid-columnHeaderTitle": {
            "fontWeight": "bold"
          },
          "height": "30px !important",
          "over-flow": "hidden"
        },
        "virtualScroller": {
          "minHeight": "30px"
        }
      },
      "defaultProps": {
        "getRowSpacing": {
          "top": 0.5,
          "bottom": 0.5
        },
        "rowHeight": 25,
        "getRowHeight": 25,
        "pageSizeOptions": [5, 10, 20],
        "localeText": {
          "noRowsLabel": "✨ No data available"
        }
      }
    },

    "MuiSelect": {
      "styleOverrides": {
        "root": {
          "& fieldset": {
            "borderColor": "#55C5D6"
          },
          "&:hover fieldset": {
            "borderColor": "#55C5D6"
          },
          "&.Mui-focused fieldset": {
            "borderColor": "#55C5D6"
          }
        }
      },
      "defaultProps": {
        "value": "",
        "variant": "outlined",
        "size": "small",
        "native": false,
        "multiple": false,
        "IconComponent": null,
        "renderValue": null,
        "displayEmpty": false,
        "autoWidth": false
      }
    },

    "MuiTextField": {
      "defaultProps": {
        "value": "",
        "variant": "outlined",
        "color": "primary",
        "size": "small",
        "type": "text",
        "disabled": false,
        "fullWidth": true,
        "required": false,
        "margin": "none",
        "error": false
      },
      "styleOverrides": {
        "root": {
          "&.ex-small input": {
            "padding": "2px 4px !important"
          },
          "& .MuiOutlinedInput-root": {
            "& fieldset": {
              "borderColor": "#55C5D6",
              "overFlow": "hidden"
            },
            "&:hover fieldset": {
              "borderColor": "#55C5D6"
            },
            "&.Mui-focused fieldset": {
              "borderColor": "#55C5D6"
            }
          }
        }
      }
    },

    "MuiDatePicker": {
      "styleOverrides": {
        "root": {
          "& .MuiOutlinedInput-root": {
            "backgroundColor": "transparent",
            "& fieldset": {
              "borderColor": "#55C5D6"
            },
            "&:hover fieldset": {
              "borderColor": "#55C5D6"
            },
            "&.Mui-focused fieldset": {
              "borderColor": "#55C5D6"
            }
          },
          "& .MuiInputBase-root": {
            "backgroundColor": "transparent",
            "color": "#2764AF",
            "borderRadius": "5px"
          },
          "& .MuiIconButton-root": {
            "color": "#2764AF"
          },
          "& .MuiSvgIcon-root": {
            "color": "#2764AF"
          }
        }
      },
      "defaultProps": {
        "slotProps": {
          "textField": {
            "size": "small",
            "variant": "outlined",
            "fullWidth": true
          }
        }
      }
    },

    "MuiDesktopDatePicker": {
      "styleOverrides": {
        "root": {
          "& .MuiOutlinedInput-root": {
            "backgroundColor": "transparent",
            "& fieldset": {
              "borderColor": "#55C5D6"
            },
            "&:hover fieldset": {
              "borderColor": "#55C5D6"
            },
            "&.Mui-focused fieldset": {
              "borderColor": "#55C5D6"
            }
          },
          "& .MuiInputBase-root": {
            "backgroundColor": "transparent",
            "color": "#2764AF",
            "borderRadius": "5px"
          },
          "& .MuiIconButton-root": {
            "color": "#2764AF"
          },
          "& .MuiSvgIcon-root": {
            "color": "#2764AF"
          }
        }
      },
      "defaultProps": {
        "slotProps": {
          "textField": {
            "size": "small",
            "variant": "outlined",
            "fullWidth": true
          }
        }
      }
    },

    "MuiMobileDatePicker": {
      "styleOverrides": {
        "root": {
          "& .MuiOutlinedInput-root": {
            "backgroundColor": "transparent",
            "& fieldset": {
              "borderColor": "#55C5D6"
            },
            "&:hover fieldset": {
              "borderColor": "#55C5D6"
            },
            "&.Mui-focused fieldset": {
              "borderColor": "#55C5D6"
            }
          },
          "& .MuiInputBase-root": {
            "backgroundColor": "transparent",
            "color": "#2764AF",
            "borderRadius": "5px"
          },
          "& .MuiIconButton-root": {
            "color": "#2764AF"
          },
          "& .MuiSvgIcon-root": {
            "color": "#2764AF"
          }
        }
      },
      "defaultProps": {
        "slotProps": {
          "textField": {
            "size": "small",
            "variant": "outlined",
            "fullWidth": true
          }
        }
      }
    },

    "MuiStaticDatePicker": {
      "styleOverrides": {
        "root": {
          "& .MuiOutlinedInput-root": {
            "backgroundColor": "transparent",
            "& fieldset": {
              "borderColor": "#55C5D6"
            },
            "&:hover fieldset": {
              "borderColor": "#55C5D6"
            },
            "&.Mui-focused fieldset": {
              "borderColor": "#55C5D6"
            }
          },
          "& .MuiInputBase-root": {
            "backgroundColor": "transparent",
            "color": "#2764AF",
            "borderRadius": "5px"
          },
          "& .MuiIconButton-root": {
            "color": "#2764AF"
          },
          "& .MuiSvgIcon-root": {
            "color": "#2764AF"
          }
        }
      },
      "defaultProps": {
        "slotProps": {
          "textField": {
            "size": "small",
            "variant": "outlined",
            "fullWidth": true
          }
        }
      }
    },

    "MuiDialog": {
      "styleOverrides": {
        "root": {},
        "paper": {
          "padding": "20px 10px",
          "& input, & .MuiInputBase-root": {
            "backgroundColor": "transparent",
            "color": "#2764AF",
            "borderRadius": "5px"
          },
          "& input[disabled] , & input[readonly], & .MuiInputBase-root.disabled": {
            "backgroundColor": "#f5f5f5",
            "color": "#9e9e9e"
          },
          "& .MuiFormControl-root:has(.MuiFormHelperText-root)": {
            "marginBottom": "10px !important"
          },
          "& .MuiFormHelperText-root": {
            "position": "absolute",
            "bottom": "-16px",
            "left": "8px",
            "margin": "0",
            "padding": "0 4px",
            "backgroundColor": "transparent",
            "color": "#d32f2f !important",
            "fontSize": "10px",
            "whiteSpace": "nowrap",
            "overflow": "hidden",
            "textOverflow": "ellipsis",
            "maxWidth": "calc(100% - 16px)",
            "cursor": "help",
            "transition": ".5s all",
            "&:before": {
              "content": "'⚠ '"
            }
          },
          "& .MuiDivider-root": {
            "height": "3px",
            "margin": "4px 0"
          },
          "& .MuiDatePicker-root .MuiOutlinedInput-root": {
            "backgroundColor": "transparent"
          },
          "& .MuiDesktopDatePicker-root .MuiOutlinedInput-root": {
            "backgroundColor": "transparent"
          },
          "& .MuiMobileDatePicker-root .MuiOutlinedInput-root": {
            "backgroundColor": "transparent"
          }
        }
      },
      "defaultProps": {
        "open": false,
        "maxWidth": "sm",
        "fullWidth": false,
        "fullScreen": false,
        "scroll": "paper",
        "keepMounted": false,
        "transitionDuration": 50
      }
    },

    "MuiPickersDay": {
      "styleOverrides": {
        "root": {
          "color": "#2764AF",
          "&.Mui-selected": {
            "backgroundColor": "#55C5D6",
            "color": "#ffffff",
            "&:hover": {
              "backgroundColor": "#2764AF"
            }
          },
          "&:hover": {
            "backgroundColor": "rgba(85, 197, 214, 0.2)"
          }
        }
      }
    },

    "MuiPickersYear": {
      "styleOverrides": {
        "root": {
          "color": "#2764AF",
          "&.Mui-selected": {
            "color": "#55C5D6"
          }
        }
      }
    },

    "MuiPickersMonth": {
      "styleOverrides": {
        "root": {
          "color": "#2764AF",
          "&.Mui-selected": {
            "color": "#55C5D6"
          }
        }
      }
    },

    "MuiDateCalendar": {
      "styleOverrides": {
        "root": {
          "backgroundColor": "#ffffff",
          "color": "#2764AF"
        }
      }
    },

    "MuiPickersToolbar": {
      "styleOverrides": {
        "root": {
          "backgroundColor": "#2764AF",
          "color": "#ffffff"
        }
      }
    },

    "MuiClockPicker": {
      "styleOverrides": {
        "root": {
          "backgroundColor": "#ffffff"
        }
      }
    }
  }
}
